	"scripts": {
		"dev": "vite",
		"dev:mock": "node scripts/dev-mock.mjs",
		"typecheck": "tsc --noEmit",
		"lint": "biome lint ./src ./electron",
		"lint:fix": "biome lint --write ./src ./electron",
		"format": "biome format --write ./src ./electron",
		"check": "biome check ./src ./electron",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "node scripts/e2e.mjs",
		"build": "node scripts/clean.mjs && vite build",
		"package": "electron-builder",
		"mac": "npm run build && electron-builder --mac",
		"win": "npm run build && electron-builder --win",
		"linux": "npm run build && electron-builder --linux",
		"wl": "npm run build && electron-builder -wl",
		"mwl": "npm run build && electron-builder -mwl",
		"preview": "vite preview",
		"release": "npm run build && electron-builder -mwl -p always",
		"release:mac": "npm run build && electron-builder --mac --publish always",
		"release:linux": "npm run build && electron-builder --linux --x64 --publish always",
		"release:win": "npm run build && electron-builder --win --x64 --publish always"
	},

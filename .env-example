# Only used to migrate sessions saved by builds before the per-install store key (see docs/modernization/migration-notes.md).
# Safe to leave empty for new development; without it an old session simply asks the user to sign in again.
VITE_ITSLEARNING_STORE_KEY=

# Optional: run the app against the local mock (npm run dev:mock)
# ITSLEARNING_MOCK_URL=http://localhost:4873   (or VITE_ITSLEARNING_MOCK_URL)
# ITSLEARNING_MOCK_DIR=../itslearning-mock-api
